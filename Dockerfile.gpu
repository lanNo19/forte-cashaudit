# Service image WITH CUDA PyTorch, for when the CV layer runs inside the API (RF-DETR, DINOv2, trackers...).
# Built on the vLLM image that is already on the VM: no extra download or disk, and torch/CUDA match vLLM's.
# Use it with API_DOCKERFILE=Dockerfile.gpu in .env (docker-compose.yml passes VLLM_IMAGE as BASE).
# The plain Dockerfile stays the default and the CI image.
ARG BASE=vllm/vllm-openai:latest
FROM ${BASE}

# checked on the VM 17 Oct: vLLM image = Python 3.12.3, pip 26.2.1, ffmpeg, torch 2.13.0+cu130, cv2 5.0.0, numpy 2.2.6.
# Its Python is the Ubuntu system one, so pip needs PIP_BREAK_SYSTEM_PACKAGES (we only add packages, never replace torch).
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PIP_BREAK_SYSTEM_PACKAGES=1 PYTHONUNBUFFERED=1 DATA_DIR=/app/var
RUN command -v ffmpeg >/dev/null 2>&1 \
 || (apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*)

WORKDIR /app
COPY requirements.txt requirements-gpu.txt ./
# torch, numpy and opencv come from the base image; install the service's other deps without touching them.
# vLLM images may ship pip or only uv, so use whichever exists.
# The constraints file pins the base image's torch/torchvision/numpy: if a CV package wants other versions, the build
# fails loudly instead of silently downloading a second multi-GB torch.
RUN if python3 -m pip --version >/dev/null 2>&1; then PIP="python3 -m pip install"; else PIP="uv pip install --system"; fi \
 && python3 -c "import importlib.metadata as m, importlib.util as u; [print(f'{p}=={m.version(p)}') for p in ('torch', 'torchvision', 'numpy') if u.find_spec(p)]" > /tmp/constraints.txt \
 && cat /tmp/constraints.txt \
 && grep -v -E '^(numpy|opencv)' requirements.txt > /tmp/req.txt \
 && $PIP -c /tmp/constraints.txt -r /tmp/req.txt \
 && (python3 -c "import cv2" 2>/dev/null || $PIP -c /tmp/constraints.txt opencv-python-headless) \
 && $PIP -c /tmp/constraints.txt -r requirements-gpu.txt \
 && python3 -c "import torch, cv2, numpy, fastapi; print('torch', torch.__version__, 'cuda', torch.version.cuda, 'cv2', cv2.__version__)"
# Bake the RF-DETR weights into the image (when rfdetr is installed) so the service needs no internet at run time
# (brief, section 7). RF-DETR downloads them into the working directory, which is /app at run time too.
ARG CV_DETECTOR=small
RUN python3 -c "import importlib.util as u, sys; sys.exit(0 if u.find_spec('rfdetr') else 1)" \
 && python3 -c "import rfdetr; getattr(rfdetr, {'nano':'RFDETRNano','small':'RFDETRSmall','medium':'RFDETRMedium','base':'RFDETRBase','large':'RFDETRLarge'}['${CV_DETECTOR}'])(device='cpu'); print('RF-DETR ${CV_DETECTOR} weights cached')" \
 || echo "no detector weights baked in (rfdetr not installed, or the download failed)"

# the vLLM image only has python3; some team commands say `python`
RUN command -v python >/dev/null 2>&1 || ln -s "$(command -v python3)" /usr/local/bin/python

COPY cashaudit cashaudit
COPY data data
COPY tools tools
EXPOSE 8000
# the base image's entrypoint is `vllm serve`: replace it. ONE uvicorn process (the job queue lives in memory).
ENTRYPOINT []
CMD ["python3", "-m", "uvicorn", "cashaudit.api:app", "--host", "0.0.0.0", "--port", "8000"]
