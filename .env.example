# Copy to .env and fill in. Never commit the real key.
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change-me
# stub | oracle (test only, never deploy) | pipeline
ANALYZER=pipeline
# worker threads; with one GPU both share the one vLLM server (vLLM batches their requests)
WORKERS=2
# analyzer deadline counted from upload; the watchdog answers with the partial result at HARD_TIMEOUT_SEC
JOB_BUDGET_SEC=270
HARD_TIMEOUT_SEC=290
# keep the jury JSON exactly as in section 10
API_EXTRA_FIELDS=false

# ---- deploy (docs/DEPLOY.md) ----
# "" = 1 GPU, http on API_PORT. "2gpu" adds vlm1. "https" adds Caddy (needs DOMAIN). Combine: 2gpu,https
COMPOSE_PROFILES=
# host port of the API: 80 when there is no domain (http://<static-ip>/), 8000 when Caddy serves 80/443
API_PORT=80
DOMAIN=
# exact vLLM image; replace with the digest you ran (vllm/vllm-openai@sha256:...) after the first good start
VLLM_IMAGE=vllm/vllm-openai:latest
# 1 once the weights are in the cache: processing then needs no internet (brief, section 7)
HF_HUB_OFFLINE=0
HF_CACHE=~/.cache/huggingface
# GPU memory share for vLLM, context and batch limits. A100 40 GB: 0.65 with 4B (~14 GB left for CV), 0.75 with 8B
VLM_GPU_MEM=0.65
VLM_MAX_LEN=16384
VLM_MAX_SEQS=16

# ---- VLM client ----
# one server per GPU, comma-separated. 2 GPUs: http://vlm0:8001/v1,http://vlm1:8002/v1
VLM_BASE_URL=http://vlm0:8001/v1
# 4B (default, ~9 GB) leaves room and time; 8B (~17.5 GB) is one line away: compare both with deploy/vm.sh eval
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
VLM_TIMEOUT_SEC=60
# what the VLM sees: frames per second, long side in px (0 = native), max frames per 16 s window, windows in flight
VLM_FPS=2
VLM_MAX_SIDE=0
VLM_MAX_FRAMES=32
VLM_CONCURRENCY=4
# images (default) | video (native Qwen3-VL timestamps, experimental: compare with eval.py first)
VLM_INPUT=images
# show only the current scene's rule cards (scene decided by one VLM question)
VLM_SCENE_FILTER=true
# violations | events | both. Compare them with tools/eval.py; on one A100 "events" leaves the most time headroom
VLM_MODE=both
# 3-5 = majority vote over sampled runs (costs proportionally more GPU time)
VLM_EVENT_SAMPLES=1
# test videos may not be kept
KEEP_VIDEOS=false
LOG_LEVEL=INFO
